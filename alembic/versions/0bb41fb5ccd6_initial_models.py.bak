    sa.Column('total_objects', sa.INTEGER(), autoincrement=False, nullable=True),
    sa.Column('objects_added', sa.INTEGER(), autoincrement=False, nullable=True),
    sa.Column('objects_updated', sa.INTEGER(), autoincrement=False, nullable=True),
    sa.Column('objects_deleted', sa.INTEGER(), autoincrement=False, nullable=True),
    sa.Column('objects_failed', sa.INTEGER(), autoincrement=False, nullable=True),
    sa.Column('status', sa.VARCHAR(length=50), autoincrement=False, nullable=True),
    sa.Column('error_message', sa.TEXT(), autoincrement=False, nullable=True),
    sa.Column('started_at', postgresql.TIMESTAMP(), autoincrement=False, nullable=True),
    sa.Column('completed_at', postgresql.TIMESTAMP(), autoincrement=False, nullable=True),
    sa.Column('duration_seconds', sa.INTEGER(), autoincrement=False, nullable=True),
    sa.Column('sync_details', postgresql.JSON(astext_type=sa.Text()), autoincrement=False, nullable=True),
    sa.Column('errors', postgresql.JSON(astext_type=sa.Text()), autoincrement=False, nullable=True),
    sa.Column('triggered_by', sa.VARCHAR(length=255), autoincrement=False, nullable=True),
    sa.Column('created_at', postgresql.TIMESTAMP(), autoincrement=False, nullable=True),
    sa.PrimaryKeyConstraint('id', name=op.f('ad_sync_history_pkey'))
    )
    op.create_index(op.f('ix_ad_sync_history_sync_type'), 'ad_sync_history', ['sync_type'], unique=False)
    op.create_index(op.f('ix_ad_sync_history_status'), 'ad_sync_history', ['status'], unique=False)
    op.create_index(op.f('ix_ad_sync_history_started_at'), 'ad_sync_history', ['started_at'], unique=False)
    op.create_index(op.f('ix_ad_sync_history_id'), 'ad_sync_history', ['id'], unique=False)
