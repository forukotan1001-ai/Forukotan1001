DEBUG=False
APP_NAME=UEBA Security Platform
ENVIRONMENT=production
SECRET_KEY=changeme_random_base64_or_from_vault
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# DATABASE_URL should not contain plaintext credentials; provide via secret manager or CI secrets
DATABASE_URL=postgresql://postgres:${DB_PASSWORD}@127.0.0.1:5432/ueba_security
DB_PASSWORD=
SQLALCHEMY_ECHO=False
LOG_LEVEL=INFO
ANOMALY_DETECTION_THRESHOLD=0.75
SKIP_ML_INIT=True
SKIP_DB_INIT=True

# SMTP and AD credentials must NOT be committed. Use environment/secret store.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASSWORD=
FROM_EMAIL=alerts@example.com
FROM_NAME=UEBA System

AD_SERVER=
AD_DOMAIN=
AD_USERNAME=
AD_PASSWORD=
AD_BASE_DN=

# CI-only secret used by smoke tests. Set as repository secret (SMOKE_PASSWORD) in Actions settings.
# SMOKE_PASSWORD=

# Notes:
# - Do NOT commit production credentials. Use a secrets manager or GitHub Actions secrets.
# - If this repo previously contained secrets in history, rotate them immediately (SMTP, AD, SECRET_KEY, etc.).